---
/**
 * Hero install terminal — macOS traffic lights, syntax-colored commands,
 * always-visible copy button.
 */
const REPO = "https://github.com/rezwanvaiya2-0/netlens.git";
---

<div class="terminal-wrap">
  <div class="terminal">
    <div class="terminal-bar">
      <span class="dot"></span><span class="dot"></span><span class="dot"></span>
      <span class="t-title">netlens install</span>
    </div>
    <div class="terminal-body">
      <button class="terminal-copy" type="button" aria-label="Copy install commands">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25v-7.5Z"/><path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25v-7.5Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25h-7.5Z"/></svg>
        <span>Copy</span>
      </button>
      <pre><code><span class="comment"># Install NetLens on your VPS</span>
<span class="prompt">$</span> <span class="cmd">git clone {REPO}</span>
<span class="prompt">$</span> <span class="cmd">cd netlens</span>
<span class="prompt">$</span> <span class="cmd">sudo ./install.sh</span>
<span class="comment"># Open the dashboard: <span class="url">http://&lt;YOUR_IP&gt;:8070/nfsen.php</span></span></code></pre>
    </div>
  </div>
</div>
