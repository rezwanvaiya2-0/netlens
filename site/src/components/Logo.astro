---
/**
 * NetLens mark — a modern network-lens identity with a clean N-based flow motif.
 */
interface Props {
  size?: number;
  class?: string;
  title?: string;
}
const { size = 38, class: className = "", title = "NetLens" } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  class={className}
  role="img"
  aria-label={title}
>
  <defs>
    <linearGradient id="nl-bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#071317" />
    </linearGradient>
    <linearGradient id="nl-ring" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#6ee7b7" />
      <stop offset="50%" stop-color="#34d399" />
      <stop offset="100%" stop-color="#22d3ee" />
    </linearGradient>
  </defs>

  <rect x="2" y="2" width="44" height="44" rx="14" fill="url(#nl-bg)" stroke="#1f3a2d" stroke-width="1.5" />
  <g stroke="url(#nl-ring)" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.85"><path d="M7 16H41" /><path d="M7 24H41" /><path d="M7 32H41" /></g>
  <g fill="#67e8f9"><circle cx="41" cy="16" r="2" /><circle cx="41" cy="24" r="2" /><circle cx="41" cy="32" r="2" /></g>
  <circle cx="24" cy="24" r="12" fill="url(#nl-ring)" opacity="0.12" /><circle cx="24" cy="24" r="12" fill="none" stroke="url(#nl-ring)" stroke-width="3" />
  <path d="M16 18a12 12 0 0 1 7-5" fill="none" stroke="#fff" stroke-opacity="0.42" stroke-width="2" stroke-linecap="round" /><circle cx="24" cy="24" r="2.3" fill="#fff" opacity="0.9" />
</svg>
