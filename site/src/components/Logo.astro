---
/**
 * NetLens mark — a modern network-lens identity with a clean N-based flow motif.
 */
interface Props {
  size?: number;
  class?: string;
  title?: string;
}
const { size = 38, class: className = "", title = "NetLens" } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  class={className}
  role="img"
  aria-label={title}
>
  <defs>
    <linearGradient id="nl-bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#071317" />
    </linearGradient>
    <linearGradient id="nl-ring" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#6ee7b7" />
      <stop offset="50%" stop-color="#34d399" />
      <stop offset="100%" stop-color="#22d3ee" />
    </linearGradient>
  </defs>

  <rect x="2" y="2" width="44" height="44" rx="14" fill="url(#nl-bg)" stroke="#1f3a2d" stroke-width="1.5" />
  <path d="M9 33V15.5h5.2l7.6 12.8 7.4-12.8H39V33h-4.8V22.2l-8.2 14h-2.4l-8.3-14V33H9Z" fill="url(#nl-ring)" opacity="0.95" />

  <g stroke="url(#nl-ring)" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.9">
    <path d="M7 12.5H41" />
    <path d="M7 35.5H41" />
    <path d="M10 9.5V38.5" />
    <path d="M38 9.5V38.5" />
  </g>

  <circle cx="39" cy="12.5" r="2.2" fill="#67e8f9" />
  <circle cx="9" cy="35.5" r="2.2" fill="#a7f3d0" />
</svg>
