---
import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "../components/Logo.astro";
import Terminal from "../components/Terminal.astro";
import GitHubIcon from "../components/GitHubIcon.astro";

const GITHUB = "https://github.com/rezwanvaiya2-0/netlens";
const TITLE = "NetLens — Dockerized NfSen NetFlow Analyzer";
const DESCRIPTION =
  "NetLens: a self-contained Docker image that collects, stores, and visualizes NetFlow data — NfSen 1.3.6p1 + NfDump 1.6.17 with a password-protected Web UI. One command to deploy.";
---

<BaseLayout title={TITLE} description={DESCRIPTION}>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <div class="hero-logo">
          <Logo size={84} />
        </div>
        <div class="eyebrow">Network visibility, simplified</div>
        <h1>See every <span class="grad-text">network flow</span> in one clean dashboard</h1>
        <p class="tagline">
          NetLens gives you a fast Docker-based way to capture, store, and analyze NetFlow traffic from
          routers and switches — with a polished web UI and no messy setup process.
        </p>

        <div class="cta">
          <a class="btn btn-primary btn-lg" href="#install">Deploy now</a>
          <a class="btn btn-outline btn-lg" href={GITHUB} target="_blank" rel="noopener">
            <GitHubIcon size={18} />
            View on GitHub
          </a>
        </div>

        <div class="badges">
          <img src="https://img.shields.io/badge/NfSen-1.3.6p1-2ea44f" alt="NfSen 1.3.6p1" />
          <img src="https://img.shields.io/badge/NfDump-1.6.17-6CC24A" alt="NfDump 1.6.17" />
          <img src={"https://img.shields.io/badge/Ubuntu-20.04-E95420?logo=ubuntu&logoColor=white"} alt="Ubuntu 20.04" />
          <img src={"https://img.shields.io/badge/Docker-ready-2496ED?logo=docker&logoColor=white"} alt="Docker" />
          <img src="https://img.shields.io/badge/Port-8070-3fb950" alt="Web UI Port 8070" />
        </div>
      </div>

      <div class="hero-panel">
        <Terminal />
      </div>
    </div>
  </section>

  <!-- ================= FEATURES ================= -->
  <section id="features">
    <div class="container">
      <h2>Built for clear network visibility</h2>
      <p class="lead">
        NetLens gives teams a simple, reliable way to collect raw NetFlow data and turn it into actionable
        traffic insights without managing a complex stack by hand.
      </p>
      <div class="cards">
        <div class="card">
          <h3>
            <span class="icon-badge">
              <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1.5 8a6.5 6.5 0 1 1 13 0 6.5 6.5 0 0 1-13 0Zm6.5 4.5a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Z"/></svg>
            </span>
            Capture
          </h3>
          <p>Listen on UDP ports 2055/2056 and collect NetFlow v5, v9, and IPFIX from routers, firewalls, and edge devices.</p>
        </div>
        <div class="card">
          <h3>
            <span class="icon-badge">
              <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M0 1.75C0 .784.784 0 1.75 0h12.5C15.216 0 16 .784 16 1.75v9.5A1.75 1.75 0 0 1 14.25 13H8.06l-2.573 2.573A1.458 1.458 0 0 1 3 14.543V13H1.75A1.75 1.75 0 0 1 0 11.25Zm1.75-.25a.25.25 0 0 0-.25.25v9.5c0 .138.112.25.25.25h2a.75.75 0 0 1 .75.75v2.19l2.72-2.72a.749.749 0 0 1 .53-.22h6.5a.25.25 0 0 0 .25-.25v-9.5a.25.25 0 0 0-.25-.25Z"/></svg>
            </span>
            Store
          </h3>
          <p>Keep all collected flow data in real folders next to your stack so it remains easy to inspect, back up, and rebuild.</p>
        </div>
        <div class="card">
          <h3>
            <span class="icon-badge">
              <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1.75 0A1.75 1.75 0 0 0 0 1.75v12.5C0 15.216.784 16 1.75 16h12.5A1.75 1.75 0 0 0 16 14.25V1.75A1.75 1.75 0 0 0 14.25 0Zm.75 13V3h4.5v10Zm6 0V7.5h4V13Z"/></svg>
            </span>
            Visualize
          </h3>
          <p>Turn raw flows into readable graphs and top-source summaries inside the built-in NfSen web interface.</p>
        </div>
        <div class="card">
          <h3>
            <span class="icon-badge">
              <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 16A8 8 0 1 1 8 0a8 8 0 0 1 0 16ZM7.25 4a.75.75 0 0 0 1.5 0v-.75a.75.75 0 0 0-1.5 0V4Zm0 6.5a.75.75 0 0 0 1.5 0V7a.75.75 0 0 0-1.5 0v3.5ZM7.25 13a.75.75 0 0 0 1.5 0v-.75a.75.75 0 0 0-1.5 0V13Z"/></svg>
            </span>
            Retain
          </h3>
          <p>Apply expiration and max-size rules directly in the UI so the daemon keeps your data clean without manual cleanup.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= HOW IT WORKS ================= -->
  <section id="how-it-works" class="alt">
    <div class="container">
      <h2>How it works</h2>
      <p class="lead">From router export to clean traffic insights in a few minutes.</p>

      <div class="pipeline">
        <div class="pipe-node">
          <div class="p-icon">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1.5 8a6.5 6.5 0 1 1 13 0 6.5 6.5 0 0 1-13 0Zm6.5 4.5a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Z"/></svg>
          </div>
          <h4>Router</h4>
          <p>Exports NetFlow data to your VPS over UDP.</p>
        </div>
        <span class="pipe-arrow">→</span>
        <div class="pipe-node">
          <div class="p-icon">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3.5 13.5a2 2 0 1 1 0-4 2 2 0 0 1 0 4ZM12.5 6.5a2 2 0 1 1 0-4 2 2 0 0 1 0 4Z"/><path d="M5.75 9.5a2.25 2.25 0 0 1-.19-.9c0-1.13.63-2.1 1.56-2.6l-1.7-2.26A2 2 0 0 1 9.3 3.3l.72.73A6.25 6.25 0 0 1 14 10.25a2.26 2.26 0 1 1-3.5.09 3.75 3.75 0 0 0-4.75-.84Z"/></svg>
          </div>
          <h4>Ports</h4>
          <p>Port forwarding sends the traffic directly into the container.</p>
        </div>
        <span class="pipe-arrow">→</span>
        <div class="pipe-node">
          <div class="p-icon">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1.5 8a6.5 6.5 0 1 1 13 0 6.5 6.5 0 0 1-13 0Zm6.5 4.5a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Z"/></svg>
          </div>
          <h4>nfcapd</h4>
          <p>Raw flow files are written automatically for each source.</p>
        </div>
        <span class="pipe-arrow">→</span>
        <div class="pipe-node">
          <div class="p-icon">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1.75 0A1.75 1.75 0 0 0 0 1.75v12.5C0 15.216.784 16 1.75 16h12.5A1.75 1.75 0 0 0 16 14.25V1.75A1.75 1.75 0 0 0 14.25 0Zm.75 13V3h4.5v10Zm6 0V7.5h4V13Z"/></svg>
          </div>
          <h4>nfsend</h4>
          <p>RRD graphs and top traffic summaries are generated for you.</p>
        </div>
        <span class="pipe-arrow">→</span>
        <div class="pipe-node">
          <div class="p-icon">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm6.5-3a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Z"/></svg>
          </div>
          <h4>Dashboard</h4>
          <p>Review charts, sources, and stats from the web UI.</p>
        </div>
      </div>

      <div class="code-block">
        <pre><code><span class="c"># Flow pipeline</span>
Router ── NetFlow ──► <span class="g">VPS port 2055/2056</span> ──► container
      ── nfcapd ──► <span class="g">nfsen-data/live/&lt;router&gt;/</span>
      ── nfsend ──► <span class="g">nfsen-stat/live/&lt;router&gt;.rrd</span>
      ──► UI <span class="k">http://YOUR_IP:8070/nfsen.php</span></code></pre>
      </div>
    </div>
  </section>

  <!-- ================= INSTALLATION ================= -->
  <section id="install">
    <div class="container">
      <h2>Installation</h2>
      <p class="lead">
        Deploy NetLens in minutes on any VPS or Linux box with Docker and start collecting flow data right away.
      </p>

      <h3>Quick start</h3>
      <div class="code-block">
        <pre><code><span class="c"># 1. Clone the repo</span>
git clone https://github.com/rezwanvaiya2-0/netlens.git
cd netlens

<span class="c"># 2. Build and start</span>
sudo ./install.sh</code></pre>
      </div>
      <div class="callout ok">
        <div class="callout-title">First run only</div>
        <p>
          The initial build takes a little longer. After that, <code>docker compose up -d</code> starts the
          stack quickly and keeps your sources, configuration, and archived data in place.
        </p>
      </div>

      <h3>Open the dashboard</h3>
      <p>Visit <code>http://&lt;YOUR_IP&gt;:8070/nfsen.php</code> in a browser. The UI is protected, and the default login is:</p>
      <table>
        <tr><th>Username</th><td><code>admin</code></td></tr>
        <tr><th>Password</th><td><code>change-me-now</code></td></tr>
      </table>
      <div class="callout warn">
        <div class="callout-title">Change the password immediately</div>
        <p>Update it in one command and keep the service live without restarting:</p>
        <div class="code-block">
          <pre><code>docker exec netlens htpasswd -b /var/nfsen/etc/.htpasswd admin YourNewPass123</code></pre>
        </div>
      </div>

      <h3>Data folders</h3>
      <p>Your data stays in four real folders next to <code>docker-compose.yml</code> — no hidden Docker-only volumes.</p>
      <table>
        <tr><th>Folder</th><th>Inside the container</th><th>Purpose</th></tr>
        <tr><td><code>nfsen-data/</code></td><td><code>/var/nfsen/profiles-data</code></td><td>Raw NetFlow capture files</td></tr>
        <tr><td><code>nfsen-stat/</code></td><td><code>/var/nfsen/profiles-stat</code></td><td>RRD graph files and charts</td></tr>
        <tr><td><code>nfsen-var/</code></td><td><code>/var/nfsen/var</code></td><td>Logs, cache, and runtime state</td></tr>
        <tr><td><code>nfsen-etc/</code></td><td><code>/var/nfsen/etc</code></td><td>Config, sources, and auth files</td></tr>
      </table>
      <ul class="tick">
        <li><strong>Back up anytime:</strong> <code>tar czf nfsen-backup.tar.gz nfsen-data nfsen-stat nfsen-var nfsen-etc</code></li>
        <li><strong>Data survives rebuilds and restarts</strong> — even a full <code>docker compose down -v</code> is safe if you keep the local folders intact.</li>
        <li><strong>Only deleting the folders themselves removes data</strong> — stop the container first if you need to clean up.</li>
      </ul>

      <h3>Connect a router</h3>
      <p>UDP ports <code>2055</code> and <code>2056</code> are already exposed, and a demo <code>router1</code> source is ready. To add another device:</p>
      <div class="code-block">
        <pre><code><span class="c"># 1. Open the port in docker-compose.yml</span>
<span class="c">#    - "2070:2070/udp"</span>

<span class="c"># 2. Add the source and reconfig</span>
docker exec netlens bash -c "sed -i \"/^);$/i\\    'myrouter' =&gt; &#123; 'port' =&gt; '2070', 'col' =&gt; '#FF0000', 'type' =&gt; 'netflow' &#125;,\" /var/nfsen/etc/nfsen.conf &amp;&amp; /var/nfsen/bin/nfsen reconfig"

<span class="c"># 3. Restart the stack</span>
docker compose up -d</code></pre>
      </div>

      <h3>Set data retention</h3>
      <p>In the Web UI, open <strong>Profile Admin → live profile → Edit</strong>. Set the retention window and storage cap, then save. The daemon applies your rules automatically in the background.</p>
    </div>
  </section>

  <!-- ================= DOCS ================= -->
  <section id="docs" class="alt">
    <div class="container">
      <h2 class="center">Helpful guides</h2>
      <p class="lead center">More details for deeper integrations and troubleshooting.</p>
      <div class="cards">
        <div class="card">
          <h3><a href="/docs/librenms-integration.html">LibreNMS Integration</a></h3>
          <p>Share the flow data over NFS and view NetFlow graphs and Top-N stats directly inside LibreNMS.</p>
        </div>
        <div class="card">
          <h3><a href={`${GITHUB}/blob/main/README.md`} target="_blank" rel="noopener">README (full reference)</a></h3>
          <p>Read the complete setup notes, retention rules, security guidance, and advanced troubleshooting details.</p>
        </div>
        <div class="card">
          <h3><a href={`${GITHUB}/issues`} target="_blank" rel="noopener">Report an issue</a></h3>
          <p>Found a bug or have a feature request? Open an issue on GitHub and the project can be improved together.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
